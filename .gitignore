# First release: review new top-level files and public assets before allowing them.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/.env.example
!/index.html
!/metadata.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/scripts/
!/docs/
/docs/*
!/docs/bible/
/docs/bible/*
!/docs/bible/ELSEWHERE_BIBLE_V1.md
!/public/
/public/*
# This is the offline application download, regenerated by npm run verify.
!/public/Elsewhere_Phase1_Standalone.html

# Dependencies, generated caches, diagnostics and browser test material.
**/node_modules/
**/dist/
**/build/
**/.cache/
**/.vite/
**/coverage/
**/artifacts/
**/test-results/
**/playwright-report/
**/blob-report/
**/screenshots/
**/recordings/
**/*.log
**/*.tsbuildinfo
**/.DS_Store

# Secrets and local credentials. Only the reviewed root example is allowed.
**/.env
**/.env.*
!/.env.example
**/.npmrc
**/.netrc
**/.pypirc
**/.aws/
**/.ssh/
**/credentials*
**/secrets*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/*.kdbx

# User saves, private preset originals, browser profiles and temporary media.
**/private/
**/user-data/
**/userdata/
**/saves/
**/backups/
**/uploads/
**/tmp/
**/temp/
**/profiles/
**/browser-profile*/
**/IndexedDB/
**/Local Storage/
**/Session Storage/
**/storageState*
**/*.sqlite*
**/*.db
**/*.db-*
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/*.rar
# Arbitrarily named private JSON exports remain excluded, including inside src.
**/*.json
!/metadata.json
!/package.json
!/package-lock.json
!/tsconfig.json
